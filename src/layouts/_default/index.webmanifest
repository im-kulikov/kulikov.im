{
  "icons": [
    {{ range $i, $e := slice (dict "file" "icon-192.png" "size" "192x192" "purpose" "any") (dict "file" "icon-512.png" "size" "512x512" "purpose" "any") (dict "file" "icon-maskable-512.png" "size" "512x512" "purpose" "maskable") }}
    {{ if $i }},{{ end }}{ "src": "{{ (resources.Get (printf "img/%s" $e.file)).RelPermalink }}", "sizes": "{{ $e.size }}", "type": "image/png", "purpose": "{{ $e.purpose }}" }
    {{ end }}
  ],
  "name": "{{site.Title}}",
  "short_name": "{{site.Title}}",
  "lang": "{{ site.Language.Locale | default `en-us` }}",
  "display": "fullscreen",
  "orientation" : "portrait",
  "start_url": "{{ "/" | absLangURL }}?utm_source=web_app_manifest",
  "background_color": "{{ site.Params.variables.body_color | default `#fff`}}",
  "theme_color": "{{ site.Params.variables.color_primary | default `#000`}}"
}